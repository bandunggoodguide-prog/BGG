# Salin file ini jadi ".env" lalu isi nilai aslinya.

# Connection string database PostgreSQL (dari Neon/Vercel Postgres/Supabase, dll)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# PIN rahasia pemilik untuk membuka menu Riwayat & Laporan. Angka 4-6 digit, bebas pilih sendiri.
OWNER_PIN="123456"

# Kunci rahasia untuk menandatangani sesi "mode pemilik" (BUKAN PIN itu sendiri).
# Isi dengan teks acak yang panjang & rahasia. Bisa generate dengan: openssl rand -base64 32
OWNER_SECRET="ganti-dengan-teks-rahasia-yang-panjang-dan-acak"
