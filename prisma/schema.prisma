generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  barcode       String?  @unique
  category      String   @default("Lainnya")
  unit          String   @default("pcs") // pcs, kg, ikat, dus, botol, dll
  icon          String   @default("package") // emoji key, see lib/icons
  color         String   @default("slate")
  costPrice     Int      @default(0) // harga modal
  priceRegular  Int // harga satuan / eceran
  priceB2B      Int // harga ke warung (antar warung)
  priceDus      Int? // harga per dus/karton (opsional, buat referensi beli stok)
  stock         Float    @default(0)
  minStock      Float    @default(5)
  quickAccess   Boolean  @default(true) // tampil di grid cepat kasir
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items      TransactionItem[]
  stockMoves StockMovement[]

  @@index([name])
  @@index([category])
}

model Transaction {
  id           String   @id @default(cuid())
  code         String   @unique // nomor struk tampilan, misal GRS-20260105-0001
  customerType String // "UMUM" | "B2B" | "DONASI"
  customerNote String? // nama pembeli B2B / penerima donasi (opsional)
  totalAmount  Int // total harga jual
  totalCost    Int // total harga modal (untuk hitung keuntungan)
  cashReceived Int?
  changeAmount Int?
  createdAt    DateTime @default(now())

  items TransactionItem[]

  @@index([createdAt])
  @@index([customerType])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  productName   String // disalin saat transaksi, jaga histori jika produk diubah/dihapus
  qty           Float
  unitPrice     Int // harga jual per unit saat transaksi (sesuai tier)
  unitCost      Int // harga modal per unit saat transaksi
  subtotal      Int

  @@index([productId])
  @@index([transactionId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String // "RESTOCK" | "ADJUST" | "SALE"
  qty       Float // positif = masuk, negatif = keluar
  note      String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}
